[Unit]
Description=musicOrganizerBot (organizador WAV/FLAC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/musicOrganizerBot
ExecStart=/home/ubuntu/musicOrganizerBot/venv/bin/python bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
