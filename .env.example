# Credenciales de app de https://my.telegram.org (pueden ser las mismas de cloneToTelegram)
TG_API_ID=
TG_API_HASH=

# Token de un bot NUEVO creado con @BotFather (no reutilices el de otro bot que este corriendo)
TG_BOT_TOKEN=
# Tu user_id numerico (@userinfobot). Solo vos podes usar el bot.
TG_OWNER_ID=

# Supergrupo destino con Temas (link de invitacion, @usuario o id)
DESTINO=https://t.me/+--D9DFr8cqgzZDAx

# Formatos de audio suelto que se juntan en ZIP (por defecto solo sin perdida)
EXTENSIONES_AUDIO=flac,wav,aiff,aif,ape,wv,dsf,dff,alac
# Minutos entre dos audios para considerarlos de albumes distintos
PAUSA_MINUTOS=30
# Los albumes subidos hace menos de esto (minutos) se dejan para la proxima corrida
ESPERA_MINUTOS=15

# Limite de subida en MiB. Vacio = automatico (4000 si tu cuenta es Premium, 2000 si no)
MAX_UPLOAD_MB=
# Tamano maximo de cada ZIP en MiB (si se pasa se parte). Vacio = el limite de subida
ZIP_MAX_MB=
# Espacio libre minimo a dejar en disco (MiB)
MARGEN_DISCO_MB=500

# Portada: grupo = la imagen del grupo si se verifica que es de ese disco (default);
# internet = primero la de internet (Cover Art Archive/iTunes/Deezer) si se encuentra el album
PORTADA_PREFERIDA=grupo

# Contacto para el User-Agent de MusicBrainz (email o URL). Recomendado por su API.
CONTACTO_MUSICBRAINZ=

# Opcional: Claude con busqueda web como ultimo recurso para elegir el tema.
# Con la clave puesta se activa solo; BUSQUEDA_CLAUDE=0 lo apaga.
ANTHROPIC_API_KEY=
BUSQUEDA_CLAUDE=
CLAUDE_MODEL=claude-opus-5-5
